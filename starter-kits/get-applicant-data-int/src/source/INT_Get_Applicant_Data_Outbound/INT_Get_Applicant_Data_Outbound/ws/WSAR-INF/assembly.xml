<?xml version="1.0" encoding="UTF-8"?>
<beans
     xmlns="http://www.springframework.org/schema/beans"
     xmlns:beans="http://www.springframework.org/schema/beans"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:cc="http://www.capeclear.com/assembly/10"
     xmlns:cloud="urn:com.workday/esb/cloud/10.0"
     xmlns:env="http://schemas.xmlsoap.org/soap/envelope/"
     xmlns:pi="urn:com.workday/picof"
     xmlns:wd="urn:com.workday/bsvc"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
 
	<cc:assembly id="WorkdayAssembly" version="2026.24">
        <cc:send-error id="global-error-handler" rethrow-error="false" routes-to="Note-Error"/>
        <cc:local-out id="Note-Error" endpoint="vm://wcc/PutIntegrationMessage">
            <cc:set name="is.message.severity" value="'CRITICAL'"/>
            <cc:set name="is.message.summary" value="context.errorMessage"/>
        </cc:local-out>
        <cc:workday-in id="StartHere" routes-to="AsyncMediation">
            <cc:integration-system name="INT_Get_Applicant_Data_Outbound"/>
        </cc:workday-in>
        <cc:async-mediation id="AsyncMediation" routes-to="GetApplicantOut">
            <cc:steps/>
        </cc:async-mediation>
        <cc:async-mediation id="AsyncMediation0" routes-to="WorkdayOutSoap">
            <cc:steps>
                <cc:write id="Write">
                    <cc:message>
                        <cc:text>&lt;bsvc:Get_Applicants_Request xmlns:bsvc=&quot;urn:com.workday/bsvc&quot; bsvc:version=&quot;v47.0&quot;>
    &lt;bsvc:Response_Group>
        &lt;bsvc:Include_Reference>true&lt;/bsvc:Include_Reference>
        &lt;bsvc:Include_Personal_Information>true&lt;/bsvc:Include_Personal_Information>
        &lt;bsvc:Show_All_Personal_Information>false&lt;/bsvc:Show_All_Personal_Information>
        &lt;bsvc:Include_Recruiting_Information>true&lt;/bsvc:Include_Recruiting_Information>
        &lt;bsvc:Include_Qualification_Profile>false&lt;/bsvc:Include_Qualification_Profile>
        &lt;bsvc:Include_Resume>false&lt;/bsvc:Include_Resume>
        &lt;bsvc:Include_Background_Check>false&lt;/bsvc:Include_Background_Check>
        &lt;bsvc:Include_External_Integration_ID_Data>false&lt;/bsvc:Include_External_Integration_ID_Data>
    &lt;/bsvc:Response_Group>
&lt;/bsvc:Get_Applicants_Request></cc:text>
                    </cc:message>
                </cc:write>
            </cc:steps>
            <cc:send-error id="SendError" routes-to="AsyncMediation2"/>
        </cc:async-mediation>
        <cc:workday-out-soap id="WorkdayOutSoap" routes-response-to="AsyncMediation1" application="Recruiting" version="47.0"/>
        <cc:async-mediation id="AsyncMediation1" routes-to="PutIntegrationMessage">
            <cc:steps>
                <cc:xml-to-json id="XmlToJson"/>
                <cc:cloud-log id="CloudLog" level="info" message="JSON Data Collected Successfully"/>
                <cc:store id="Store" title="data.json"/>
            </cc:steps>
        </cc:async-mediation>
        <cc:async-mediation id="AsyncMediation2">
            <cc:steps>
                <cc:cloud-log id="CloudLog" level="error" message="Error: on Transformation"/>
            </cc:steps>
        </cc:async-mediation>
        <cc:local-in id="GetApplicantIn" routes-to="AsyncMediation0"/>
        <cc:local-out id="PutIntegrationMessage" endpoint="vm://wcc/PutIntegrationMessage"><cc:set name="is.message.severity" value="'INFO'"/><cc:set name="is.message.summary" value="&quot;Completed Applicant Data JSON&quot;"/></cc:local-out>
        <cc:local-out id="GetApplicantOut" store-message="none" routes-response-to="AsyncMediation3" endpoint="vm://INT_Get_Applicant_Data_Outbound/GetApplicantIn"/>
        <cc:async-mediation id="AsyncMediation3" routes-to="PutIntegrationMessage0">
            <cc:steps>
                <cc:store id="Store" input="variable" input-variable="cloud-log-content" title="log.html"/>
            </cc:steps>
        </cc:async-mediation>
        <cc:local-out id="PutIntegrationMessage0" endpoint="vm://wcc/PutIntegrationMessage"><cc:set name="is.message.severity" value="'INFO'"/><cc:set name="is.message.summary" value="&quot;Completed Integration&quot;"/></cc:local-out>
	</cc:assembly>

</beans>